{
  "name": "dsh-plugin-publisher",
  "displayName": "DSH Plugin Publisher",
  "description": "Publish a DSH plugin to GitHub as a tool the agent calls, so another machine can install it with dsh plugin add github:<owner>/<repo>. Validates the manifest, initialises the repository, creates the GitHub repo, uploads the tree, and sets the dsh-plugin topic.",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gty2408/dsh-plugin-publisher.git"
  },
  "homepage": "https://github.com/Gty2408/dsh-plugin-publisher#readme",
  "bugs": {
    "url": "https://github.com/Gty2408/dsh-plugin-publisher/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "publish",
    "github",
    "release",
    "devtools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
